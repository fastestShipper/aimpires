# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated agent artifacts (per-world filesystem storage)
/worlds_data/

# deploy scripts with credentials — never commit
/.tmp/
*.deploy.sh

# Kenney source dirs (we only ship the flattened GLBs in public/models/{buildings,nature,chars})
/public/models/kenney_city/
/public/models/kenney_chars/
/public/models/nature_src/
/public/models/chars_src/
/public/models/*.zip

# playwright artifacts from dev testing
/.playwright-mcp/
aimpires-*.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
